{
  "colors": {
    "background": { "hex": "#0b0e17", "rgb": [11, 14, 23],   "sgr_bg": "48;2;11;14;23",  "ansi256": 233 },
    "text":       { "hex": "#d5d9e4", "rgb": [213, 217, 228], "sgr_fg": "38;2;213;217;228", "ansi256": 253 },
    "muted":      { "hex": "#8a93a8", "rgb": [138, 147, 168], "sgr_fg": "38;2;138;147;168", "ansi256": 103, "use": "labels, detail, pending" },
    "emphasis":   { "hex": "#f2f4f9", "rgb": [242, 244, 249], "sgr_fg": "1;38;2;242;244;249", "ansi256": 255, "use": "titles, in progress (bold)" },
    "accent":     { "hex": "#7aa7ff", "rgb": [122, 167, 255], "sgr_fg": "38;2;122;167;255", "ansi256": 111, "use": "ids, agent tags, open issues, bar fill" },
    "done":       { "hex": "#62d394", "rgb": [98, 211, 148],  "sgr_fg": "38;2;98;211;148",  "ansi256": 78,  "use": "done nodes, merged issues" },
    "blocked":    { "hex": "#f0a35e", "rgb": [240, 163, 94],  "sgr_fg": "38;2;240;163;94",  "ansi256": 215, "use": "blocked nodes and reasons" },
    "edge":       { "hex": "#5d6987", "rgb": [93, 105, 135],  "sgr_fg": "38;2;93;105;135",  "ansi256": 60,  "use": "connectors (decorative)" },
    "track":      { "hex": "#2a3144", "rgb": [42, 49, 68],    "sgr_fg": "38;2;42;49;68",    "ansi256": 236, "use": "rules, empty bar (decorative)" },
    "selection":  { "hex": "#18203a", "rgb": [24, 32, 58],    "sgr_bg": "48;2;24;32;58",    "ansi256": 235, "use": "selected node fill, active tab" }
  },
  "states": {
    "done":        { "glyph": "✓", "border": "light",  "corners": "╭╮╰╯", "h": "─", "v": "│", "color": "done",     "title": "done + bold" },
    "in_progress": { "glyph": "●", "border": "heavy",  "corners": "┏┓┗┛", "h": "━", "v": "┃", "color": "emphasis", "title": "emphasis + bold" },
    "pending":     { "glyph": "○", "border": "dashed", "corners": "╭╮╰╯", "h": "┄", "v": "┆", "color": "muted",    "title": "muted" },
    "blocked":     { "glyph": "■", "border": "light",  "corners": "╭╮╰╯", "h": "─", "v": "│", "color": "blocked",  "title": "blocked + bold, reason line in blocked color" }
  },
  "issue_states": { "merged": "done", "open": "accent" },
  "glyphs": {
    "selected_marker": "▸", "agent_tag": "◂", "arrow_down": "↓", "arrow_right": "→",
    "bar_fill": "━", "rule": "─", "separator_dot": "·",
    "tree": { "branch": "├─", "last": "└─", "pipe": "│" },
    "edge": { "v": "│", "h": "─", "tl": "╭", "tr": "╮", "bl": "╰", "br": "╯", "t_down": "┬", "t_up": "┴", "cross": "┼", "dashed_v": "┆" },
    "fallback": { "◂": "<", "▸": ">", "■": "x", "┄": "-", "┆": ":", "heavy_box": "light box in bold" }
  },
  "layout": {
    "mock_size": { "cols": 140, "rows": 44 },
    "margin_cols": 1,
    "header_rows": 6,
    "footer_rows": 3,
    "sibling_gap_cols": 2,
    "level_gap_rows": 4,
    "node_min_w": 21,
    "node_max_w": 33,
    "node_padding": 1,
    "narrow_switch": "if needed width > available width, use the vertical layout"
  }
}
